# ==============================================================================
# MTG UTILS - LOCAL ENVIRONMENT VARIABLES
# ==============================================================================

# 1. LOCAL POSTGRESQL DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mtg_utils?schema=public"

# 2. APP CONFIGURATION
BACKEND_URL="http://localhost:8000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# 3. EXTERNAL API KEYS (OPTIONAL)
CARDTRADER_API_TOKEN="your-cardtrader-bearer-token"

# 4. DOCKER MEDIA INFRASTRUCTURE
# Replace the defaults below before exposing these services outside development.
MINIO_ROOT_USER=mtg-utils
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET=mtg-images

# Hex-encoded 32-byte key and salt used by imgproxy and the worker to sign URLs.
IMGPROXY_KEY=736f6d65333262797465736c6f6e676b6579666f726465766f6e6c79
IMGPROXY_SALT=736f6d65333262797465736c6f6e6773616c74666f726465766f6e6c79

# URL reachable by browsers, not the Docker-internal service address.
PUBLIC_IMAGE_BASE_URL=http://localhost:8080/images

# Bulk metadata cache. all_cards also resolves Spanish locally (larger database).
SCRYFALL_BULK_ENABLED=true
SCRYFALL_BULK_TYPE=default_cards
